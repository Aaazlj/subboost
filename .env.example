# 数据库配置
POSTGRES_DB=subboost
POSTGRES_USER=subboost
POSTGRES_PASSWORD=subboost_secret_pw

# 应用连接串（在 docker compose 内部使用 db:5432）
DATABASE_URL=postgresql://subboost:subboost_secret_pw@db:5432/subboost?schema=public

# 安全密钥（可根据需要修改为 32 字节随机字符串）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=subboost_jwt_secret_token_default_key_2026
CRON_SECRET=subboost_cron_secret_token_default_key_2026

# 服务端口与访问路径（部署在 clash.leozai.com/admin 下）
SUBBOOST_PORT=38921
BASE_PATH=/admin
APP_URL=https://clash.leozai.com/admin
TRUST_PROXY_HEADERS=true
